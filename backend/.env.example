# Neon Postgres connection string
# Note the +psycopg — we installed the psycopg (v3) driver, and a bare
# postgresql:// URL defaults to the psycopg2 driver, which isn't installed.
DATABASE_URL=postgresql+psycopg://user:password@host/dbname

# Redis connection string (filled in properly in Phase 11)
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Secret used to sign auth tokens (filled in properly in Phase 10)
JWT_SECRET=changeme

# Paystack secret key (test mode starts with sk_test_, live with sk_live_)
# Find it in your Paystack dashboard under Settings > API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_changeme

# Used to build the callback_url Paystack redirects back to after payment
FRONTEND_URL=http://localhost:3000
